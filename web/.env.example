# --- Database ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/camtrip

# --- Sessions ---
# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=

# --- Sign in with Apple ---
# Comma-separated bundle id(s) / service id(s) allowed as audience
APPLE_CLIENT_IDS=app.camtrip.camtrip
# Server-to-server Sign in with Apple (token revocation on account deletion,
# App Store guideline 5.1.1(v)). Key from Certificates, IDs & Profiles > Keys with
# "Sign in with Apple" enabled for app.camtrip.camtrip. APPLE_TEAM_ID is below.
# Without these, exchange/revocation is skipped (a warning is logged).
APPLE_SIWA_KEY_ID=
# Contents of AuthKey_XXXX.p8: raw PEM, with \n escapes, or base64
APPLE_SIWA_KEY_P8=
# Optional, default app.camtrip.camtrip (must match the app's bundle id)
APPLE_CLIENT_ID=app.camtrip.camtrip
# Optional: key for encrypting stored Apple refresh tokens (AES-256-GCM).
# Defaults to a key derived from JWT_SECRET. Changing it makes stored tokens unusable.
APPLE_TOKEN_ENC_KEY=

# --- Google Sign-In ---
# Comma-separated OAuth client ids allowed as audience: the web/server client id
# (Android tokens are issued for this one) and the iOS client id.
# e.g. 1234-web.apps.googleusercontent.com,1234-ios.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=

# --- E-mail (password reset codes) via Resend ---
# Without a key the code is not sent (a warning is logged).
RESEND_API_KEY=
# Optional, default "CamTrip <noreply@camtrip.app>" (domain must be verified in Resend)
MAIL_FROM=

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=camtrip-media

# --- App admins ("Beheer" in the app) ---
# Comma-separated e-mail addresses that become admin on sign-in (case-insensitive).
# Only counts when the address is verified: Apple/Google sign-in, or an e-mail
# account that did a password reset once. Admins always have Pro.
ADMIN_EMAILS=aplamper06@gmail.com

# --- RevenueCat ---
REVENUECAT_REST_API_KEY=
# Exact value of the Authorization header set on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_PRO_ENTITLEMENT_ID=pro

# --- Push (Apple APNs, direct - no third party) ---
APNS_KEY_ID=
APNS_TEAM_ID=4K4D59MXKW
# Contents of the AuthKey_XXXX.p8 file (newlines as 
)
APNS_KEY_P8=
APNS_BUNDLE_ID=app.camtrip.camtrip

# --- Vercel Cron ---
CRON_SECRET=

# --- App links (universal links / app links) + Sign in with Apple client secret ---
APPLE_TEAM_ID=4K4D59MXKW
IOS_BUNDLE_ID=app.camtrip.camtrip
ANDROID_PACKAGE=app.camtrip.camtrip
# Comma-separated SHA-256 cert fingerprints (Play App Signing + upload key)
ANDROID_SHA256_FINGERPRINTS=

# --- Store links shown on the website ---
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/camtrip/id0000000000
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.camtrip.camtrip
